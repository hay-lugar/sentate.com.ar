# Copiar a .env.local. Solo claves PUBLICABLES: nunca la service_role / secret key en el frontend.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Origen público de la app para los enlaces de email (alta y recuperación). Solo el origen, sin ruta.
# Producción: https://sentate.com.ar  ·  Local: http://localhost:3000. Debe coincidir con Site URL de Auth.
APP_URL=http://localhost:3000

# Límite de solicitudes de mesa por conexión (IP). Obligatorio en producción: sin esto el formulario público falla
# cerrado en vez de quedar sin protección. Ver docs/reservas-piloto.md.
#   RATE_LIMIT_IP_HEADER: header con la IP del cliente que pone TU plataforma y un cliente no puede falsear.
#   RATE_LIMIT_SECRET:    32+ caracteres al azar. Firma la IP con HMAC: la base nunca ve la IP.
#   RATE_LIMIT_MODE=off:  apagado explícito (solo desarrollo local o demo).
RATE_LIMIT_MODE=off
# RATE_LIMIT_IP_HEADER=x-real-ip
# RATE_LIMIT_SECRET=
